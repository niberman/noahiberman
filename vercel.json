{
  "buildCommand": "node scripts/inoah-eval.mjs && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{backend/tests/**,backend/scripts/**}"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index"
    },
    {
      "source": "/scheduling/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/sync/:path*",
      "destination": "/api/index"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/api/index"
    },
    {
      "source": "/hermes",
      "destination": "/hermes/index.html"
    },
    {
      "source": "/hermes/",
      "destination": "/hermes/index.html"
    },
    {
      "source": "/hermes/privacy",
      "destination": "/hermes/privacy/index.html"
    },
    {
      "source": "/hermes/privacy/",
      "destination": "/hermes/privacy/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/resume",
      "destination": "/resume/index.html"
    },
    {
      "source": "/aviation",
      "destination": "/aviation/index.html"
    },
    {
      "source": "/now",
      "destination": "/now/index.html"
    },
    {
      "source": "/es",
      "destination": "/es/index.html"
    },
    {
      "source": "/work/flight-school-ops",
      "destination": "/work/flight-school-ops/index.html"
    },
    {
      "source": "/work/preflight-briefing",
      "destination": "/work/preflight-briefing/index.html"
    },
    {
      "source": "/work/owner-portal",
      "destination": "/work/owner-portal/index.html"
    },
    {
      "source": "/work/flight-log",
      "destination": "/work/flight-log/index.html"
    },
    {
      "source": "/work/inoah",
      "destination": "/work/inoah/index.html"
    },
    {
      "source": "/work/smoothie-king-checklist",
      "destination": "/work/smoothie-king-checklist/index.html"
    },
    {
      "source": "/work/artnimality",
      "destination": "/work/artnimality/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/sync/logbook",
      "schedule": "0 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=UTF-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=86400"
        }
      ]
    }
  ],
  "trailingSlash": false
}
