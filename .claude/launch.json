{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "preview-build",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "port": 8080,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["main:app", "--reload", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    }
  ]
}
