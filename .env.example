# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Get these from your Supabase project settings:
# https://app.supabase.com/project/[your-project]/settings/api

# Local Supabase: run `supabase start`, then `npm run env:from-supabase` to print
# VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY / VITE_SUPABASE_FUNCTIONS_URL from the CLI.
# Hosted: Dashboard -> Project Settings -> API (same three values).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# Optional. Local FastAPI scheduling backend (slots, booking, Google OAuth exchange).
# On Vercel, this repo now serves those endpoints at same-origin (`/scheduling/*`),
# so you usually do not need VITE_API_BASE in production unless the backend lives elsewhere.
VITE_API_BASE=http://localhost:8000

# iNoah public chat (Supabase Edge Function proxy)
# Defaults use VITE_SUPABASE_URL if FUNCTIONS URL is not set
VITE_SUPABASE_FUNCTIONS_URL=https://your-project.supabase.co
VITE_INOAH_FUNCTION_PATH=/functions/v1/inoah-chat

# Sovereign Chat link in navigation (set to "true" to show)
VITE_ENABLE_CHAT_LINK=false

# iNoah Hands remote control (Dashboard) — must match AGENT_SECRET_KEY on the host
VITE_AGENT_URL=http://127.0.0.1:8000
# Long random string, e.g. `openssl rand -hex 32`. The widget stays disabled while unset.
VITE_AGENT_SECRET=

# ForeFlight logbook sync (Vercel Cron target: GET /api/sync/logbook, daily 06:00 UTC).
# Gmail app password (not your login) — generate at https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# Service role key is required to replace the flights snapshot in Supabase.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Long random string — Vercel Cron auto-sends this as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=generate-a-long-random-string

# ---------------------------------------------------------------------------
# iNoah Edge Function secrets
#
# These are NOT read from this file. Edge Functions read their own secret store,
# so set them with the CLI (or Dashboard -> Edge Functions -> Secrets):
#
#   supabase secrets set OPENROUTER_API_KEY=sk-or-v1-...
#   supabase secrets set EMBEDDING_API_KEY=...
#
# Listed here so the full set of keys iNoah needs lives in one place.
# ---------------------------------------------------------------------------

# REQUIRED. The only chat provider for both twins (inoah-chat,
# inoah-chat-private) and the only key model spend bills to. There is no
# fallback route: without this, chat returns a 500. Get one at
# https://openrouter.ai/keys.
# OPENROUTER_API_KEY=sk-or-v1-...

# Embeddings only, and a separate provider on purpose: OpenRouter serves no
# embeddings endpoint, and every vector in `memories` came from
# gemini-embedding-2 at 768 dims, so a different model or width would be
# incomparable to what is stored. Used by inoah-embed, inoah-ingest,
# inoah-sync-drive and the retrieval step of both twins; without it the twins
# still answer, just with no retrieved context. Currently a Google AI Studio
# key. Reads GEMINI_API_KEY as a fallback so the old secret keeps working.
# EMBEDDING_API_KEY=...
